# Copy to .env and fill in. Everything is optional.

# --- AI judge and copywriter (pick one, or none) ---
# OpenRouter: free key at https://openrouter.ai/keys. Ids ending in ":free" cost nothing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Ollama: fully offline. Install from https://ollama.com, then:  ollama pull gemma3:4b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# --- Speech to text ---
# tiny, base, small or medium. "small" suits a 4 GB GPU like the GTX 1650.
WHISPER_MODEL=small
WHISPER_DEVICE=auto

# --- Fonts for Kannada / Hindi captions (sudo apt install fonts-noto-core) ---
KANNADA_FONT=Noto Sans Kannada
HINDI_FONT=Noto Sans Devanagari

MAX_UPLOAD_MB=4096
MAX_SOURCE_MINUTES=180
