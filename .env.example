# Copy this file to .env and fill it in. Everything is optional.

# Free key from https://openrouter.ai/keys. Without it Clipzer uses its built-in moment picker.
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models. Ids ending in ":free" cost nothing.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# tiny, base, small or medium. "small" suits a 4 GB GPU like the GTX 1650.
WHISPER_MODEL=small
# auto tries the GPU first, then the CPU.
WHISPER_DEVICE=auto

# Caption font. Must be installed on this computer. For Kannada install "Noto Sans Kannada".
CAPTION_FONT=Noto Sans
